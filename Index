  <script>
    function showMessage(message) {
      alert(message);
    }

    function filterHomes() {
      const location = document.getElementById("locationSearch").value.toLowerCase();
      const type = document.getElementById("propertyType").value;
      const bedrooms = Number(document.getElementById("bedrooms").value || 0);
      const price = Number(document.getElementById("priceRange").value || 0);

      const cards = document.querySelectorAll(".property-card");
      let visible = 0;

      cards.forEach(card => {
        const matchesLocation = !location || card.dataset.location.includes(location);
        const matchesType = !type || card.dataset.type === type;
        const matchesBedrooms = !bedrooms || Number(card.dataset.bedrooms) >= bedrooms;
        const matchesPrice = !price || Number(card.dataset.price) <= price;

        const show = matchesLocation && matchesType && matchesBedrooms && matchesPrice;

        card.style.display = show ? "block" : "none";
        if (show) visible++;
      });

      document.getElementById("noResults").style.display =
        visible === 0 ? "block" : "none";
    }

    function calculateSavings() {
      const homePrice = Number(document.getElementById("homePrice").value || 0);
      const platformCost = Number(document.getElementById("platformCost").value || 0);

      const traditionalCost = homePrice * 0.06;
      const difference = traditionalCost - platformCost;

      document.getElementById("savingsResult").textContent =
        "Potential difference compared with a 6% commission: $" +
        Math.max(0, difference).toLocaleString();
    }
  </script>

